# TrustVault Environment Variables Template
# Copy this file to .env and supply actual deployment values

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustvault_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# ASP.NET Core Connection String
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=trustvault_db;Username=postgres;Password=your_secure_db_password_here;

# JWT Security Configuration
Jwt__Issuer=TrustVault
Jwt__Audience=TrustVaultUsers
Jwt__SecretKey=REPLACE_WITH_A_SECURE_MIN_32_CHAR_RANDOM_SECRET_KEY
Jwt__ExpiryMinutes=120

# Initial Admin Seeding (Used only on initial startup if no admin exists)
SeedData__AdminEmail=admin@trustvault.local
SeedData__AdminPassword=ChangeMeImmediatelyInProduction123!

# CORS Configuration (Production Frontend Origins - comma or semicolon separated)
Cors__AllowedOrigins=https://your-app.vercel.app,http://localhost:5173

# Database Provider Selection (PostgreSQL or Sqlite)
DatabaseProvider=PostgreSQL

# Storage Configuration
# Set Storage__Provider to S3 for persistent cloud storage (AWS S3, Cloudflare R2, MinIO)
Storage__Provider=Local
Storage__LocalVaultPath=SecureVaultStorage
Storage__S3BucketName=trustvault-private-vault
Storage__S3ServiceUrl=https://<account-id>.r2.cloudflarestorage.com
Storage__S3Region=auto
AWS_ACCESS_KEY_ID=your_s3_access_key_here
AWS_SECRET_ACCESS_KEY=your_s3_secret_key_here

